{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Company instructions selected from a committed Git tree",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "instructions"],
  "properties": {
    "schema": {"const": 1},
    "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_. -]{0,79}$"},
    "instructions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9_./-]+\\.md$"}
    }
  }
}
