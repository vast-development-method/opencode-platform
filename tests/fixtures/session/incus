#!/usr/bin/env bash
set -Eeuo pipefail

if [ "${1:-}" = info ]; then
    [ "${MOCK_INCUS_DIRECT_ACCESS:-true}" = true ]
    exit
fi
if [ "${1:-}" = --project ]; then
    shift 2
fi

printf '%q ' "$@" >> "${MOCK_INCUS_LOG:?MOCK_INCUS_LOG is required}"
printf '\n' >> "$MOCK_INCUS_LOG"

# The generic session fixture represents an image where Joomla MCP is disabled.
if [ "${1:-}" = exec ] && [[ "$*" == *'.mcp.joomla.enabled == true'* ]]; then
    exit 1
fi

case "${1:-}:${2:-}" in
    image:show|init:*)
        exit 0
        ;;
    info:*)
        [ "${MOCK_INCUS_INSTANCE_EXISTS:-true}" = true ]
        exit
        ;;
    start:*)
        [ "${MOCK_INCUS_START_FAIL:-false}" != true ]
        exit
        ;;
    list:--format)
        cat "${MOCK_INCUS_LIST:?MOCK_INCUS_LIST is required for list}"
        ;;
    stop:*|delete:*|config:set|config:unset|file:push|exec:*)
        exit 0
        ;;
    *)
        printf 'Unexpected session mock Incus invocation: %s\n' "$*" >&2
        exit 1
        ;;
esac
