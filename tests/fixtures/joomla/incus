#!/usr/bin/env bash
set -Eeuo pipefail
[[ "${1:-}" != info ]] || exit 0
if [[ "${1:-}" == --project ]]; then shift 2; fi
case "${1:-}" in
    info|start) exit 0 ;;
    exec)
        shift 2
        while [[ "${1:-}" != -- && $# -gt 0 ]]; do shift; done
        shift
        if [[ "${1:-}" == flock ]]; then
            shift 3
            [[ "${1:-}" == configure ]] || exit 1
            "${JOOMLA_TEST_HELPER:?}" configure "${CAPTURE_CONFIG:?}" "${CAPTURE_OPENCODE:?}" "$4" "$5" "$6" "$7" "$8"
        fi
        ;;
    *) printf 'Unexpected mock Incus command.\n' >&2; exit 1 ;;
esac
