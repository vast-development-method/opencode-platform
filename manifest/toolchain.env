GIT_MCP_EXPECTED_VERSION=

PLAYWRIGHT_MCP_PACKAGE=@playwright/mcp@latest
PLAYWRIGHT_PACKAGE=playwright@latest
PLAYWRIGHT_EXPECTED_VERSION=

OPENBAO_IMAGE=
LITELLM_IMAGE=
CADDY_IMAGE=
