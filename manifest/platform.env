PLATFORM_NAME=vdm-opencode-platform
PLATFORM_VERSION=0.1.0

INCUS_PROJECT=vdm-agents
INCUS_BUILD_NETWORK=vdm-buildbr0
INCUS_RUNTIME_NETWORK=vdm-agentbr0
INCUS_RUNTIME_ACL=vdm-agent-runtime

INCUS_BASE_IMAGE=images:ubuntu/24.04/cloud
INCUS_IMAGE_PREFIX=vdm-opencode
INCUS_STORAGE_POOL=
INCUS_DEFAULT_ROOT_SIZE=80GiB

AGENT_USER=opencode
AGENT_HOME=/home/opencode
WORKSPACE_ROOT=/workspace

GITEA_BASE_URL=https://git.vdm.dev
NEXTCLOUD_BASE_URL=https://nextcloud.example.invalid
GITHUB_BASE_URL=https://github.com

DEFAULT_SESSION_TTL=2h
DEFAULT_IMAGE_RETENTION=5
